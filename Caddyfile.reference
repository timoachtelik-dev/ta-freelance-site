# Reference Caddy config for the dual-site deployment.
#
# This file is NOT applied automatically. It documents the server-side config
# that belongs in /etc/caddy/Caddyfile on vm824. After editing the live file:
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy
#
# Both sites are SPAs built from this repo (VITE_PROFILE_MODE selects the
# variant). The contact form posts to /api/contact, served by the Node/Express
# backend in server/ on port 8787.

(spa) {
	encode zstd gzip

	# Fingerprinted build assets (Vite hashes) + self-hosted fonts: cache hard.
	@immutable path /assets/* /fonts/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML must always revalidate so new deploys are picked up immediately.
	@html path / /index.html *.html
	header @html Cache-Control "no-cache"

	# Forward the contact API to the Express backend.
	reverse_proxy /api/* 127.0.0.1:8787

	# SPA fallback: every non-file route serves index.html so deep links
	# (e.g. /about, /contact) return 200 instead of 404.
	try_files {path} /index.html
	file_server
}

freelance.timo-achtelik.de {
	root * /var/www/freelance
	import spa
}

profile.timo-achtelik.de {
	root * /var/www/profile
	import spa
}
